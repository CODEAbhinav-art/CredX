# CredX Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Backend CORS origin (set to frontend URL in production)
BACKEND_CORS_ORIGIN=http://localhost:3000

# Backend port
BACKEND_PORT=8000

# Frontend API base URL (used by Next.js to call backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to force deterministic fallback (skip LLM calls) - useful for testing
LLM_FORCE_FALLBACK=false
